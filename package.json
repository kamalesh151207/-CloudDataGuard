{
  "name": "codealpha-data-redundancy-removal",
  "version": "1.0.0",
  "description": "CloudDataGuard - Professional Cloud-Based Data Redundancy Removal System",
  "main": "server/server.js",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "cd server && npm start",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test"
  },
  "keywords": [
    "cloud-data-guard",
    "deduplication",
    "mongodb",
    "codealpha",
    "data-quality"
  ],
  "author": "CloudDataGuard Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
